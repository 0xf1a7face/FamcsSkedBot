# HTTP заголовки для Cloudflare Pages
# Документация: https://cloudflare.com

/*
  # Разрешаем iframe внутри Telegram Web и убираем X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://telegram.org https://*.telegram.org https://web.telegram.org https://t.me
  # Предотвращение XSS атак
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  # CORS заголовки для обращения к другим доменам
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS

# Не задавать общий Cache-Control: Pages объединяет совпавшие заголовки.
# Корневой URL и /index.html — разные правила сопоставления.
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/app.js
  Cache-Control: no-cache, must-revalidate

/src/*
  Cache-Control: no-cache, must-revalidate

/styles.css
  Cache-Control: no-cache, must-revalidate

# Шрифты: имена файлов версионированы (v20/v9) и не меняются между деплоями
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
